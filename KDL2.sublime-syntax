      - match             : '(?={{u_sp}}*((\S[\s\S]*?[^\\])|([^\\\s]))""")'
        push              :
        - include         : de␠e_s
        - match           : '(""")'
          scope           : punctuation.definition.string.end.kdl
          pop             : 4
        - include         : S🛑¹”””p4
  strings-quoted-double:
    - match               : '(r?)(")'
      captures            :
        1:                  invalid.illegal.position.kdl
        2:                  punctuation.definition.string.begin.kdl
      push                :
      - meta_scope        : meta.string.kdl string.quoted.double.kdl
      - match             : '"'
        scope             : punctuation.definition.string.end.kdl
        pop               : 1
      - include           : char-escaped
      - include           : ␤🛑¹s
  strings-quoted-double3:
    - match               : '(r?)(""")({{nl_not_s}}?)({{nl_not_s}}*)'
      captures            :
        1:                 invalid.illegal.position.kdl
        2:                 punctuation.definition.string.begin.kdl
        3:                 invalid.illegal.position.kdl
        4:                 invalid.illegal.muted.position.kdl
      push                :
      - meta_scope        : meta.string.kdl string.quoted.double.block.kdl
      - include           : ch⎋“s # before ↓ to handle valid \""" and non w␠⎋
      - include           : ch⎋¬“s
      - include           : uni⎋s
      - include           : de␠e”””⸮ # attaches the last w␠⎋ to the ending """ instead of the body
      - include           : char-esc-multi
      - match             : '({{u_sp}}*)(""")'
        captures          :
          1:               whitespace.dedent.kdl
          2:               punctuation.definition.string.end.kdl
        pop               : 1
      - match             : '^(?={{u_sp}}*((\S[\s\S]*?[^\\])|([^\\\s]))""")'
        push              :
        - include         : de␠e_s
        - match           : '(""")'
          scope           : punctuation.definition.string.end.kdl
          pop             : 2
        - include         : S🛑¹”””p2
      # same without ^start of line since char-esc-multi can eat up all whitespace up to """, so there will be no start of line for this rule
      - match             : '(?={{u_sp}}*((\S[\s\S]*?[^\\])|([^\\\s]))""")'
        push              :
        - include         : de␠e_s
        - match           : '(""")'
          scope           : punctuation.definition.string.end.kdl
          pop             : 2
        - include         : S🛑¹”””p2
  strings-quoted-double_node-id:
    - match               : '(r?)(")'
      captures            :
        1:                  invalid.illegal.position.kdl
        2:                  punctuation.definition.string.begin.kdl
      push                :
      - meta_scope        : entity.name.tag.node.kdl meta.string.kdl string.quoted.double.kdl
      - match             : '"'
        scope             : punctuation.definition.string.end.kdl
        pop               : 1
      - include           : char-escaped
      - include           : ␤🛑¹s
